{
  "name": "stockpulse",
  "version": "1.0.0",
  "description": "Production-grade offline-first Inventory, Purchase Order, and GST Billing Management System",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "stockpulse": "./bin/stockpulse-cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
